rules_version = '2';
// Permissions are checked on the server: hiding a button in the app is not security.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().isActive == true;
    }
    function isSuper() { return isActive() && userDoc().role == 'Super Admin'; }
    function hasPerm(p) {
      return isActive() && (isSuper()
        || p in get(/databases/$(database)/documents/roles/$(userDoc().roleId)).data.permissions);
    }
    function hasAny(a, b) { return hasPerm(a) || hasPerm(b); }
    function superSafe() {
      return isSuper()
        || (request.resource.data.role != 'Super Admin'
            && (resource == null || resource.data.role != 'Super Admin'));
    }
    // Regional / Department managers only see their own region / department.
    // The app adds the matching where() automatically.
    function inScope(d) {
      return (userDoc().role != 'Regional Manager' && userDoc().role != 'Department Manager')
        || (userDoc().role == 'Regional Manager' && d.regionId == userDoc().regionId)
        || (userDoc().role == 'Department Manager' && d.departmentId == userDoc().departmentId);
    }
    function purgeable() { return resource.data.isDeleted == true; }

    // ---------- users / roles / master data ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || hasPerm('user.view'));
      allow create: if hasPerm('user.create') && superSafe();
      allow update: if (hasPerm('user.update') && superSafe())
        || (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone']));
      allow delete: if false;
    }
    match /roles/{roleId} { allow read: if isActive(); allow write: if isSuper(); }
    match /regions/{id}                  { allow read: if isActive(); allow write: if hasPerm('lookup.manage'); }
    match /departments/{id}              { allow read: if isActive(); allow write: if hasPerm('lookup.manage'); }
    match /commercial_registrations/{id} { allow read: if isActive(); allow write: if hasPerm('lookup.manage'); }

    // ---------- employees & documents ----------
    match /employees/{id} {
      allow read: if hasPerm('employee.view') && inScope(resource.data);
      allow create: if hasPerm('employee.create');
      allow update: if hasPerm('employee.update') || hasPerm('employee.delete') || hasPerm('trash.restore');
      allow delete: if hasPerm('trash.purge') && purgeable();
    }
    match /employee_documents/{id} {
      allow read: if hasAny('expiry.view', 'employee.view') && inScope(resource.data);
      allow create, update: if hasPerm('employee.update');
      allow delete: if hasPerm('employee.update');
    }
    match /ajeer_records/{id} {
      allow read: if hasPerm('ajeer.view') && inScope(resource.data);
      allow create, update: if hasPerm('ajeer.update') || hasPerm('trash.restore');
      allow delete: if hasPerm('trash.purge') && purgeable();
    }

    // ---------- payroll ----------
    match /payroll_ledger/{id} {
      allow read: if hasPerm('ledger.view') && inScope(resource.data);
      // overpayment is blocked server-side unless the user holds payment.override
      allow create: if hasPerm('payment.create');
      allow update: if (hasPerm('payment.create') || hasPerm('payment.reverse'))
        && (request.resource.data.paid <= request.resource.data.netPayable || hasPerm('payment.override'));
      allow delete: if false;
    }
    match /payments/{id} {
      allow read: if hasPerm('payment.view') && inScope(resource.data);
      allow create: if hasPerm('payment.create');
      allow update: if hasPerm('payment.reverse');   // reversal only; never deleted
      allow delete: if false;
    }

    // ---------- loans ----------
    match /loans/{id} {
      allow read: if hasPerm('loan.view') && inScope(resource.data);
      allow create: if hasPerm('loan.create');
      allow update: if hasPerm('loan.create') || hasPerm('loan.approve') || hasPerm('loan.recover') || hasPerm('trash.restore');
      allow delete: if hasPerm('trash.purge') && purgeable();
    }
    match /loan_transactions/{id} {
      allow read: if hasPerm('loan.view') && inScope(resource.data);
      allow create: if hasPerm('loan.approve') || hasPerm('loan.recover');
      allow update, delete: if false;
    }

    // ---------- EOSB ----------
    match /eosb/{id} {
      allow read: if hasPerm('eosb.view') && inScope(resource.data);
      allow create: if hasPerm('eosb.create');
      allow update: if hasPerm('eosb.create') || hasPerm('eosb.approve') || hasPerm('eosb.pay') || hasPerm('trash.restore');
      allow delete: if hasPerm('trash.purge') && purgeable();
    }
    match /eosb_payments/{id} {
      allow read: if hasPerm('eosb.view') && inScope(resource.data);
      allow create: if hasPerm('eosb.pay');
      allow update, delete: if false;
    }

    // ---------- attendance ----------
    match /attendance/{id} {
      allow read: if hasPerm('attendance.view') && inScope(resource.data);
      allow create, update: if hasPerm('attendance.create') || hasPerm('attendance.update');
      allow delete: if false;
    }

    // ---------- expenses / compliance / assets ----------
    match /expenses/{id} {
      allow read: if hasPerm('expense.view') && inScope(resource.data);
      allow create: if hasPerm('expense.create');
      allow update: if hasPerm('expense.create') || hasPerm('expense.approve') || hasPerm('expense.pay') || hasPerm('trash.restore');
      allow delete: if hasPerm('trash.purge') && purgeable();
    }
    match /compliance_costs/{id} {
      allow read: if hasPerm('compliance.view');
      allow create: if hasPerm('compliance.create');
      allow update: if hasPerm('compliance.update') || hasPerm('compliance.create') || hasPerm('trash.restore');
      allow delete: if hasPerm('trash.purge') && purgeable();
    }
    match /assets/{id} {
      allow read: if hasPerm('asset.view');
      allow create: if hasPerm('asset.create');
      allow update: if hasPerm('asset.update') || hasPerm('asset.assign') || hasPerm('trash.restore');
      allow delete: if hasPerm('trash.purge') && purgeable();
    }
    match /asset_assignments/{id} {
      allow read: if hasPerm('asset.view');
      allow create, update: if hasPerm('asset.assign');
      allow delete: if false;
    }

    // ---------- audit trail: append-only ----------
    match /audit_logs/{id} {
      allow read: if hasPerm('audit.view');
      allow create: if isActive() && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
